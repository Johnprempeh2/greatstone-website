# Greatstone Commerce Platform — environment template.
# Copy to `.env` (gitignored) and fill in. NEVER commit real values.
# Publishable keys (VITE_*_ANON, *_PUBLISHABLE) are safe in the client bundle.
# Everything marked SECRET is server/edge-only and must never reach the client or git.

# ---- Supabase ----
VITE_SUPABASE_URL=                 # https://<project>.supabase.co  (or local http://127.0.0.1:54321)
VITE_SUPABASE_ANON_KEY=            # publishable anon key (safe in client)
SUPABASE_SERVICE_ROLE_KEY=         # SECRET — edge functions / server only; bypasses ALL RLS
SUPABASE_DB_PASSWORD=              # SECRET — db password / direct connection
SUPABASE_DB_URL=                   # SECRET — full postgres:// connection string (contains the password)
SUPABASE_PROJECT_REF=              # project ref for `supabase link`
SUPABASE_ACCESS_TOKEN=             # SECRET — personal access token (sbp_...) for the Supabase CLI

# ---- Stripe (TEST MODE ONLY in this file) ----
VITE_STRIPE_PUBLISHABLE_KEY=       # pk_test_...  (safe in client)
STRIPE_SECRET_KEY=                 # SECRET — sk_test_...  edge function only
STRIPE_WEBHOOK_SECRET=             # SECRET — whsec_...   edge function only

# ---- Transactional email (Resend) ----
RESEND_API_KEY=                    # SECRET — re_...  edge function only (order-confirmation + auth email)
RESEND_FROM=                       # e.g. "Greatstone <orders@greatstonesoftware.co.uk>" (verified sender domain)

# ---- App ----
# Canonical public origin for SEO (canonical link, og:url, schema.org) + the editor's SEO preview.
# Leave BLANK to track the live host automatically (domain-portable, correct on any root domain).
# At the real-domain cutover, set this to the public origin, e.g. https://greatstonesoftware.co.uk.
# NOTE: VITE_SITE_ORIGIN is the ONLY origin knob the app reads (src/lib/site-origin.mjs). An older
# VITE_APP_URL is NOT read by the code — do not rely on it. See docs/DOMAIN-CUTOVER.md.
VITE_SITE_ORIGIN=
VAT_RATE=0.20                      # UK VAT, prices shown ex-VAT, VAT added at checkout
VITE_VAT_RATE=0.20                 # client-side VAT display (keep in step with VAT_RATE)
DEFAULT_CURRENCY=GBP

# ---- AI assist (Claude) ----
ANTHROPIC_API_KEY=                 # SECRET — edge function only (bulk/AI ops)
# Website front door (`front-door` edge function). ANTHROPIC_API_KEY above must be the key of the
# website-only Anthropic workspace with a monthly spend cap, not a shared key (GRE-416 spec §5).
TURNSTILE_SECRET_KEY=              # SECRET — Cloudflare Turnstile secret (test: 1x0000000000000000000000000000000AA)
FRONT_DOOR_SECRET=                 # SECRET — 32+ random chars; signs visit sessions and keys the IP hash
FRONT_DOOR_PRIVATE_NAMES=          # SECRET — optional comma list of names no output may contain; never commit values

# ---- Local dev (Postgres without Supabase, for schema/data/logic validation) ----
LOCAL_DATABASE_URL=postgres://localhost:5432/greatstone_dev
