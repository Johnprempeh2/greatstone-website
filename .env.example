# Greatstone Commerce Platform — environment template.
# Copy to `.env` (gitignored) and fill in. NEVER commit real values.
# Publishable keys (VITE_*_ANON, *_PUBLISHABLE) are safe in the client bundle.
# Everything marked SECRET is server/edge-only and must never reach the client or git.

# ---- Supabase ----
VITE_SUPABASE_URL=                 # https://<project>.supabase.co  (or local http://127.0.0.1:54321)
VITE_SUPABASE_ANON_KEY=            # publishable anon key (safe in client)
SUPABASE_SERVICE_ROLE_KEY=         # SECRET — edge functions / server only
SUPABASE_DB_PASSWORD=              # SECRET — db password / direct connection
SUPABASE_PROJECT_REF=              # project ref for `supabase link`

# ---- Stripe (TEST MODE ONLY in this file) ----
VITE_STRIPE_PUBLISHABLE_KEY=       # pk_test_...  (safe in client)
STRIPE_SECRET_KEY=                 # SECRET — sk_test_...  edge function only
STRIPE_WEBHOOK_SECRET=             # SECRET — whsec_...   edge function only

# ---- App ----
VITE_APP_URL=http://localhost:5173
VAT_RATE=0.20                      # UK VAT, prices shown ex-VAT, VAT added at checkout
DEFAULT_CURRENCY=GBP

# ---- AI assist (Claude) ----
ANTHROPIC_API_KEY=                 # SECRET — edge function only (bulk/AI ops)

# ---- Local dev (Postgres without Supabase, for schema/data/logic validation) ----
LOCAL_DATABASE_URL=postgres://localhost:5432/greatstone_dev
