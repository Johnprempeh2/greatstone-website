# Greatstone Commerce Platform — environment template.
# Copy to `.env` (gitignored) and fill in. NEVER commit real values.
# Publishable keys (VITE_*_ANON, *_PUBLISHABLE) are safe in the client bundle.
# Everything marked SECRET is server/edge-only and must never reach the client or git.

# ---- Supabase ----
VITE_SUPABASE_URL=                 # https://<project>.supabase.co  (or local http://127.0.0.1:54321)
VITE_SUPABASE_ANON_KEY=            # publishable anon key (safe in client)
SUPABASE_SERVICE_ROLE_KEY=         # SECRET — edge functions / server only; bypasses ALL RLS
SUPABASE_DB_PASSWORD=              # SECRET — db password / direct connection
SUPABASE_DB_URL=                   # SECRET — full postgres:// connection string (contains the password)
SUPABASE_PROJECT_REF=              # project ref for `supabase link`
SUPABASE_ACCESS_TOKEN=             # SECRET — personal access token (sbp_...) for the Supabase CLI

# ---- Stripe (TEST MODE ONLY in this file) ----
VITE_STRIPE_PUBLISHABLE_KEY=       # pk_test_...  (safe in client)
STRIPE_SECRET_KEY=                 # SECRET — sk_test_...  edge function only
STRIPE_WEBHOOK_SECRET=             # SECRET — whsec_...   edge function only

# ---- Transactional email (Resend) ----
RESEND_API_KEY=                    # SECRET — re_...  edge function only (order-confirmation + auth email)
RESEND_FROM=                       # e.g. "Greatstone <orders@greatstoneint.com>" (verified sender domain)
FRONT_DOOR_ALERT_TO=               # edge function only — internal inbox(es) for front door lead alerts, comma list
FRONT_DOOR_BOOKING_URL=            # edge function only — optional; the walk-through link in the team pack (default: the site's Calendly)
ENQUIRY_ALERT_TO=                  # server only — the enquiry owner's inbox(es), comma list; the `enquiry` function (Netlify since GRE-1794) sends no alert without it
APP_SITE_ORIGIN=                   # server only — optional; the origin for the studio link in the enquiry alert (default https://greatstoneint.com)

# ---- CRM (Pipedrive) — front door leads with contact consent (GRE-469); dormant while the token is blank ----
PIPEDRIVE_API_TOKEN=               # SECRET — edge function only
PIPEDRIVE_DOMAIN=                  # edge function only — optional company subdomain (the "x" in x.pipedrive.com)
PIPEDRIVE_STAGE_ID=                # edge function only — optional; the stage new deals open in (default: the account's first pipeline)

# ---- App ----
# Canonical public origin for SEO (canonical link, og:url, schema.org) + the editor's SEO preview.
# Leave BLANK to track the live host automatically (domain-portable, correct on any root domain).
# At the real-domain cutover, set this to the public origin, e.g. https://greatstoneint.com.
# NOTE: VITE_SITE_ORIGIN is the ONLY origin knob the app reads (src/lib/site-origin.mjs). An older
# VITE_APP_URL is NOT read by the code — do not rely on it. See docs/DOMAIN-CUTOVER.md.
VITE_SITE_ORIGIN=
VAT_RATE=0.20                      # UK VAT, prices shown ex-VAT, VAT added at checkout
VITE_VAT_RATE=0.20                 # client-side VAT display (keep in step with VAT_RATE)
DEFAULT_CURRENCY=GBP

# ---- Next.js release reader (server only) ----
GSAM_SITE_ID=                      # GSAM website_site UUID; also stamped into the baked release at build time
GSAM_ORG_ID=                       # owning organisation id; also stamped into the baked release at build time
GSAM_RELEASE_BLOBS_STORE=website-releases # site-wide Netlify Blobs store used by the GSAM publisher

# ---- AI assist (Claude) ----
ANTHROPIC_API_KEY=                 # SECRET — edge function only (bulk/AI ops)
# Website front door (`front-door` edge function). ANTHROPIC_API_KEY above must be the key of the
# website-only Anthropic workspace with a monthly spend cap, not a shared key (GRE-416 spec §5).
TURNSTILE_SECRET_KEY=              # SECRET — Cloudflare Turnstile secret, also checked by the `enquiry` Netlify Function; unset = enquiry check skipped, one warning per cold start (test: 1x0000000000000000000000000000000AA)
VITE_TURNSTILE_SITE_KEY=           # public — the Turnstile site key the front door and the enquiry form render; unset = no widget (test: 1x00000000000000000000AA)
FRONT_DOOR_SECRET=                 # SECRET — 32+ random chars; signs visit sessions and keys the IP hash
FRONT_DOOR_PRIVATE_NAMES=          # SECRET — optional comma list of names no output may contain; never commit values
FRONT_DOOR_STUB=                   # local, or GRE-1988's dedicated Netlify staging site only: 1 = fixed replies instead of a model. Never enable on the public site

# ---- Netlify Better Auth (server only; GRE-1991 staging site) ----
BETTER_AUTH_URL=                   # origin of the approved staging site; no trailing path
BETTER_AUTH_SECRET=                # SECRET — random signing key, at least 32 characters
NETLIFY_DB_URL=                    # set by Netlify Database; never expose in VITE_ variables

# ---- Local dev (Postgres without Supabase, for schema/data/logic validation) ----
LOCAL_DATABASE_URL=postgres://localhost:5432/greatstone_dev
