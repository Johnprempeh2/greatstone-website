{
  "name": "greatstone-puck-proof",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Proof: the Greatstone front-end native in React, with Puck as the in-app visual editor and the bespoke three.js as a React component.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/gen-seo-files.mjs",
    "build": "vite build",
    "postbuild": "node scripts/check-dist-secrets.mjs",
    "preview": "vite preview",
    "deploy:preview": "node scripts/deploy-site.mjs preview",
    "deploy:prod": "node scripts/deploy-site.mjs prod",
    "test": "node --test",
    "check:dist": "node scripts/check-dist-secrets.mjs",
    "redirects": "node scripts/gen-legacy-redirects.mjs",
    "redirects:check": "node scripts/gen-legacy-redirects.mjs --check",
    "redirects:audit": "node scripts/gen-legacy-redirects.mjs --audit",
    "verify:staff": "node scripts/verify-staff.mjs",
    "secrets:list": "node scripts/list-edge-secrets.mjs",
    "secrets:check": "node scripts/list-edge-secrets.mjs --check",
    "seo:report": "node scripts/seo-report.mjs",
    "launch:check": "node scripts/seo-report.mjs --launch && node scripts/legal-check.mjs",
    "rls:check": "node scripts/check-rls.mjs",
    "design:detect": "node scripts/design-detect.mjs",
    "preflight": "npm test && npm run build && npm run redirects:check && npm run secrets:check && npm run rls:check",
    "build:next": "node scripts/gen-seo-files.mjs && node scripts/prepare-puck-css.mjs && node next-proof/scripts/export-build-release.mjs && next build",
    "check:legacy:next": "node next-proof/scripts/check-legacy-urls.mjs",
    "dev:next": "node scripts/gen-seo-files.mjs && node scripts/prepare-puck-css.mjs && node next-proof/scripts/export-pages.mjs && next dev --port 5181"
  },
  "dependencies": {
    "@measured/puck": "^0.20.2",
    "@netlify/blobs": "^11.1.6",
    "@netlify/database": "2.0.1",
    "@puckeditor/core": "^0.23.0",
    "@supabase/supabase-js": "^2.108.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "3.0.3",
    "better-auth": "^1.7.12",
    "happy-dom": "^20.14.5",
    "html2canvas-pro": "2.5.2",
    "next": "^15.5.28",
    "pg": "8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@netlify/database-dev": "1.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "supabase": "^2.106.0",
    "vite": "^6.0.0"
  }
}
