{
  "name": "greatstone-puck-proof",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Proof: the Greatstone front-end native in React, with Puck as the in-app visual editor and the bespoke three.js as a React component.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/gen-seo-files.mjs",
    "build": "vite build",
    "postbuild": "node scripts/check-dist-secrets.mjs",
    "preview": "vite preview",
    "test": "node --test",
    "check:dist": "node scripts/check-dist-secrets.mjs",
    "redirects": "node scripts/gen-legacy-redirects.mjs",
    "redirects:check": "node scripts/gen-legacy-redirects.mjs --check",
    "redirects:audit": "node scripts/gen-legacy-redirects.mjs --audit",
    "verify:staff": "node scripts/verify-staff.mjs",
    "secrets:list": "node scripts/list-edge-secrets.mjs",
    "preflight": "npm test && npm run build && npm run redirects:check"
  },
  "dependencies": {
    "@measured/puck": "^0.20.2",
    "@supabase/supabase-js": "^2.108.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.14.5",
    "supabase": "^2.106.0",
    "vite": "^6.0.0"
  }
}
